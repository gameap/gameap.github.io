---
---
{%- assign prefix = '/ru/' -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign pages = site.pages | sort: 'url' -%}
{%- for p in pages -%}
{%- assign head = p.url | slice: 0, 4 -%}
{%- if head == prefix and p.layout == 'default' and p.hidden != true -%}
{%- assign clean_path = p.url | replace: '/ru/', '/' | replace: '/en/', '/' | replace: '/es/', '/' %}
  <url>
    <loc>{{ site.domains.ru }}{{ clean_path }}</loc>
    <xhtml:link rel="alternate" hreflang="ru" href="{{ site.domains.ru }}{{ clean_path }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.domains.en }}{{ clean_path }}"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.domains.es }}{{ clean_path }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.domains.en }}{{ clean_path }}"/>
  </url>
{%- endif -%}
{%- endfor %}
</urlset>
